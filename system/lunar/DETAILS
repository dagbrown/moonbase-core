          MODULE=lunar
         VERSION=48.4
          SOURCE=$MODULE-$VERSION.tar.bz2
SOURCE_DIRECTORY=$BUILD_DIRECTORY/$MODULE-$VERSION
      SOURCE_URL=https://lunar.lart.ca/dl/lunar/
      SOURCE_VFY=sha256:478dc9541a3bcdfafc318d1dfa69a63b06fa3233987db3052630369818258259
        WEB_SITE=http://lunar-linux.org/
         ENTERED=20020218
         UPDATED=20260324
           SHORT="lunar contains the package management tools for Lunar-Linux."
USE_WRAPPERS=off

cat << 'EOF'
lunar - Tools package management by source.

lunar includes the following files:

configuration files:
    /etc/lunar/config      global Lunar config
    /etc/lunar/dialogrc    dialog configuration
    /etc/lunar/local       local lunar config
    /etc/lunar/mirrors     list of mirrors for common software

programs:
    /usr/sbin/lunar    menu driven interface
    /usr/sbin/lget     downloads modules sources
    /usr/sbin/lin      installs modules
    /usr/sbin/lrm      removes modules
    /usr/sbin/lvu      provides information about the box

other files:
    /var/lib/lunar/excluded     list of files that are ignored
    /var/lib/lunar/protected    list of files that will not be deleted
    /var/lib/lunar/functions    common subroutines

and man pages.

For a full list of files in the `lunar` module, use
    lvu installed lunar
It can even inspect itself!

EOF
